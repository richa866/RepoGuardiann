# ==============================================================================
# RepoGuardian — Environment Configuration
# ==============================================================================

# --- GitHub Integration ---
# GitHub Personal Access Token (classic or fine-grained) with public_repo / repo:read scope.
# Raises GitHub rate limits from 60 requests/hr to 5,000 requests/hr.
GITHUB_TOKEN=ghp_your_github_token_here

# Target GitHub repository to monitor in "owner/repo" format.
# Selected default: encode/httpx (300+ issues, active maintainer discussions, regressions, closed decision comments)
TARGET_REPO=encode/httpx

# --- Agent LLM Configuration ---
# Anthropic API Key for Claude-based agent reasoning, subtask synthesis, and triage verdict generation.
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here

# Optional: Google Gemini API Key (if using Gemini model provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Email Notifications (Resend, https://resend.com) ---
# Optional -- new-PR emails to the logged-in maintainer are skipped (not an
# error) if this is empty. Free tier's default sender needs no domain setup,
# but can only send to the email on the Resend account itself -- the GitHub
# account you sign into this app with must use that same email.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=RepoGuardian <onboarding@resend.dev>

# --- Background Polling & Monitoring ---
# Polling interval (in seconds) between automatic checks for new/updated issues and subtask queue processing.
POLL_INTERVAL_SECONDS=90

# --- Local Storage & Vector DB Paths ---
# Path to SQLite database file.
DB_PATH=./data/repoguardian.db

# Path to ChromaDB persistent vector storage directory.
CHROMA_PATH=./data/chromadb

# --- Sync Configuration ---
# Batch sizes for initial and full synchronization.
CONNECT_SYNC_MAX_ITEMS=30
FULL_SYNC_MAX_ITEMS=300
LOG_LEVEL=INFO
