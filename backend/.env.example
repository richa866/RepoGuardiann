# --- GitHub Integration ---
# Optional: if both of these are set, RepoGuardian auto-connects and syncs
# this repo once at startup (no clicking required). Leave both blank to boot
# straight into the "connect a repo" screen and pick one live from the UI
# instead -- either path works, and they use the exact same connect/sync code.
#
# Personal access token (classic or fine-grained) with repo:read scope.
# Only needed for private repos or to raise the unauthenticated 60/hr GitHub
# API rate limit to 5000/hr -- public repos work with GITHUB_TOKEN left blank.
GITHUB_TOKEN=

# Repository to auto-connect at startup, in "owner/repo" form, e.g. "facebook/react"
GITHUB_REPO=

# --- LLM (agent reasoning / synthesis) ---
# Free-tier Gemini API key from https://aistudio.google.com/apikey
# (Stack note: we substituted Gemini for the originally-specified Anthropic key
#  because the hackathon stack calls for the free Gemini tier. See README.)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Monitoring loop ---
# Seconds between automatic "check for new/updated issues" polls of the active repo.
MONITOR_POLL_INTERVAL_SECONDS=300

# --- Sync sizing ---
# Issues fetched when a repo is connected LIVE from the frontend. Kept small
# by default so a token-free (60/hr) connect finishes comfortably within the
# unauthenticated rate limit -- raise it once you've added GITHUB_TOKEN.
CONNECT_SYNC_MAX_ITEMS=30
# Issues fetched by the "Sync now" button / POST /sync (manual full resync).
FULL_SYNC_MAX_ITEMS=300

# --- Misc ---
DATABASE_PATH=./data/repoguardian.db
CHROMA_PATH=./data/chroma
LOG_LEVEL=INFO
