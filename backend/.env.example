# ==============================================================================
# RepoGuardian — Backend Environment Configuration
# ==============================================================================

# --- GitHub Integration ---
GITHUB_TOKEN=ghp_your_github_token_here
TARGET_REPO=encode/httpx

# --- Agent LLM Configuration ---

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Email Notifications (Resend, https://resend.com) ---
# Optional -- new-PR emails are skipped (not an error) if this is empty.
# Free tier's default sender (onboarding@resend.dev) works with zero domain
# setup, but can only send to the email on the Resend account itself -- the
# GitHub account you sign into this app with must use that same email.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=RepoGuardian <onboarding@resend.dev>

# --- Background Polling & Monitoring ---
POLL_INTERVAL_SECONDS=90

# --- Local Storage & Vector DB Paths ---
DB_PATH=./data/repoguardian.db
CHROMA_PATH=./data/chromadb

# --- Sync Configuration ---
CONNECT_SYNC_MAX_ITEMS=30
FULL_SYNC_MAX_ITEMS=300
LOG_LEVEL=INFO
